{
  "name": "kiwi-merge",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "app:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && npm run electron\"",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "concurrently": "9.1.2",
    "electron": "33.3.1",
    "vite": "6.0.7",
    "vue": "3.5.13",
    "wait-on": "8.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
